# =============================================
#  B2B Multi-Agent Supply Negotiation
#  Environment Configuration
# =============================================

# LLM Provider: ollama (default) | openai | anthropic | groq | gemini
PROVIDER=ollama

# --- Ollama (default, runs locally) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI ---
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Groq (fast inference) ---
# PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini ---
# PROVIDER=gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# =============================================
#  Negotiation Settings
# =============================================
MAX_ROUNDS=10
BUYER_COMPANY=AcmeCorp Manufacturing
SELLER_COMPANY=GlobalSupplyCo
BUYER_LOCATION=Barcelona, Spain
SELLER_LOCATION=Düsseldorf, Germany
